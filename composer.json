{
    "name": "mmoollllee/filament-builder-extensions",
    "description": "Opt-in tools for Filament Builder and Repeater items: editable titles in item headers, dragging items between lists, copy and paste via the clipboard, and adding items from outside the field",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "filamentphp",
        "laravel",
        "builder",
        "repeater",
        "title",
        "drag-and-drop",
        "clipboard"
    ],
    "authors": [
        {
            "name": "Moritz Graf",
            "email": "mg@moritz-graf.de"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/forms": "^5.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "filament/filament": "^5.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-browser": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "conflict": {
        "mmoollllee/filament-builder-title": "*"
    },
    "autoload": {
        "psr-4": {
            "Mmoollllee\\FilamentBuilderExtensions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mmoollllee\\FilamentBuilderExtensions\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mmoollllee\\FilamentBuilderExtensions\\FilamentBuilderExtensionsServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "test": [
            "@clear",
            "@php vendor/bin/pest"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
